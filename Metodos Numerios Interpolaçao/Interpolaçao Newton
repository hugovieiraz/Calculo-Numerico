import numpy as np

n = 4
X = np.array([1.20, 1.35, 1.65, 1.80])
Y = np.array([0.1823, 0.3001, 0.5008, 0.5878])
x = 1.75
D = np.zeros((n, n))
D[:, 0] = Y

# tabela de diferenças divididas
for j in range(1, n):
    for i in range(j, n):
        D[i, j] = (D[i, j-1] - D[i-1, j-1]) / (X[i] - X[i-j])

# cálculo do polinômio de Newton em x
p = 0
for i in range(0, n):
    termo = D[i, i]
    for k in range(0, i):
        termo = termo * (x - X[k])
    p = p + termo

print('p(x) = %.7f' % p)
