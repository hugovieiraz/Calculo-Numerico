import numpy as np

A = np.array([[4, -1, 0],
              [-1, 4, -1],
              [0, -1, 3]])

b = np.array([15, 10, 10])
x = np.array([0, 0, 0])   # chute inicial
n = 3

it = int(input("Digite o número de iterações: "))

for k in range(it):
    for i in range(n):
        s = 0
        for j in range(n):
            if j != i:
                s += A[i, j] * x[j]
        x[i] = (b[i] - s) / A[i, i]
    print("Iteração", k+1, ":", x)

print("\nSolução aproximada após", it, "iterações:")
print(x)
